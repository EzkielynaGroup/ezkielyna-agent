exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode uninstall --help 1`] = `
"ezkielyna uninstall

remove Ezkielyna Agent from this computer (--purge also deletes settings, sign-in, sessions and
cache)

Options:
  -h, --help        show help                                                              [boolean]
  -v, --version     show version number                                                    [boolean]
      --print-logs  print logs to stderr                                                   [boolean]
      --log-level   log level                   [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                           [boolean]
      --purge       also delete settings, sign-in, sessions, state and cache (~/.config,
                    ~/.local/share, ~/.local/state, ~/.cache under ezkielyna)
                                                                          [boolean] [default: false]
  -y, --yes         do not ask for confirmation                           [boolean] [default: false]"
`;

