exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode github install --help 1`] = `
"⠀         ▄            ▄               
█▀▀█ ▀▀▀█ █ ▄▀ ▄ █▀▀█  █ █  █ █▀▀▄ ▄▀▀█
█▀▀▀  ▄▀  █▀▄  █ █▀▀▀  █ ▀▀▀█ █  █ █▀▀█
▀▀▀▀ █▄▄▄ ▀  ▀ ▀ ▀▀▀▀  ▀ ▄▄▄▀ ▀▀▀▀ ▀▀▀▀

Commands:
  ezkielyna completion                          generate shell completion script
  ezkielyna acp                                 start ACP (Agent Client Protocol) server
  ezkielyna mcp                                 manage MCP (Model Context Protocol) servers
  ezkielyna [project]                           start ezkielyna tui                        [default]
  ezkielyna attach <url>                        attach to a running ezkielyna server
  ezkielyna run [message..]                     run ezkielyna with a message
  ezkielyna exec [prompt..]                     run one task without the interactive UI (scripts and
                                                CI; --json prints one JSON event per line)
  ezkielyna doctor                              check the key, connection, models, settings, folder
                                                trust, disk space and updates
  ezkielyna lapor                               create a redacted report for beta support
                                                                               [aliases: bug-report]
  ezkielyna debug                               debugging and troubleshooting tools
  ezkielyna providers                           manage AI providers and credentials  [aliases: auth]
  ezkielyna agent                               manage agents
  ezkielyna upgrade [target]                    upgrade ezkielyna to the latest signed release
  ezkielyna uninstall                           remove Ezkielyna Agent from this computer (--purge
                                                also deletes settings, sign-in, sessions and cache)
  ezkielyna serve                               starts a headless ezkielyna server
  ezkielyna web                                 start ezkielyna server and open web interface
  ezkielyna models [provider]                   list all available models
  ezkielyna account                             show your Ezkielyna plan, remaining quota or balance
  ezkielyna trust [dir]                         trust a project folder (its plugins, tools,
                                                settings, AGENTS.md and --permission-mode only apply
                                                in trusted folders)
  ezkielyna stats                               show token usage and cost statistics
  ezkielyna export [sessionID]                  export session data as JSON
  ezkielyna import <file>                       import session data from JSON file
  ezkielyna pr <number>                         fetch and checkout a GitHub PR branch, then run
                                                ezkielyna
  ezkielyna session                             manage sessions
  ezkielyna plugin <module>                     install plugin and update config     [aliases: plug]
  ezkielyna db                                  database tools
  ezkielyna memory <action>                     inspect or erase the local memory (MEMORY.md,
                                                USER.md, search index)
  ezkielyna review [prompt..]                   review code changes with the P0-P3 rubric
                                                (uncommitted by default)
  ezkielyna gateway telegram <action> [args..]  manage or run the Telegram gateway bridge

Positionals:
  project  path to start ezkielyna in                                                       [string]

Options:
  -h, --help             show help                                                         [boolean]
  -v, --version          show version number                                               [boolean]
      --print-logs       print logs to stderr                                              [boolean]
      --log-level        log level              [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure             run without external plugins                                      [boolean]
      --port             port to listen on                                     [number] [default: 0]
      --hostname         hostname to listen on                       [string] [default: "127.0.0.1"]
      --mdns             enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                          [boolean] [default: false]
      --mdns-domain      custom domain name for mDNS service (default: ezkielyna.local)
                                                               [string] [default: "ezkielyna.local"]
      --cors             additional domains to allow for CORS                  [array] [default: []]
  -m, --model            model to use in the format of provider/model                       [string]
  -c, --continue         continue the last session                                         [boolean]
  -s, --session          session id to continue                                             [string]
      --fork             fork the session when continuing (use with --continue or --session)
                                                                                           [boolean]
      --prompt           prompt to use                                                      [string]
      --agent            agent to use                                                       [string]
      --auto             auto-approve permissions that are not explicitly denied (dangerous!)
                                                                          [boolean] [default: false]
      --permission-mode  permission mode: ask, acceptEdits, plan, safeAuto, full (untrusted folders
                         always ask)                                                        [string]
      --mini             start the minimal interactive interface          [boolean] [default: false]
      --no-replay        disable mini session history replay on resume and after resize    [boolean]
      --replay-limit     cap visible mini replay to the newest N messages                   [number]
"
`;

