+package cache
+
+import (
+	"testing"
+	"time"
+)
+
+func TestSetTTL(t *testing.T) {
+	now := time.Unix(0, 0)
+	c := New[string, string](time.Second, func() time.Time { return now })
+	c.SetTTL("k", "v", 10*time.Millisecond)
+	now = now.Add(10 * time.Millisecond)
+	if _, ok := c.Get("k"); ok {
+		t.Fatal("expired entry returned")
+	}
+}
