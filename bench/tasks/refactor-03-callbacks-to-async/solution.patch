+export async function loadSettings(file: string): Promise<Settings> {
+  const value = await readJson(file).catch((err: NodeJS.ErrnoException) => {
+    if (err.code === "ENOENT") return {}
+    throw err
   })
+  return { ...DEFAULTS, ...(value as Partial<Settings>) }
