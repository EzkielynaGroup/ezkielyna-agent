-export function loadSettings(file: string, cb: (err: Error | null, settings?: Settings) => void) {
-  readJson(file, (err, value) => {
-    if (err && (err as NodeJS.ErrnoException).code === "ENOENT") return cb(null, { ...DEFAULTS })
