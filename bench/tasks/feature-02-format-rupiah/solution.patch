diff --git a/src/format.ts b/src/format.ts
index 8c28693..fc956c8 100644
--- a/src/format.ts
+++ b/src/format.ts
@@ -3,3 +3,9 @@ const BULAN = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "O
 export function formatTanggal(tanggal: Date) {
   return `${tanggal.getUTCDate()} ${BULAN[tanggal.getUTCMonth()]} ${tanggal.getUTCFullYear()}`
 }
+
+export function formatRupiah(nilai: number): string {
+  const bulat = Math.round(Math.abs(nilai))
+  const angka = String(bulat).replace(/\B(?=(\d{3})+(?!\d))/g, ".")
+  return `${nilai < 0 && bulat !== 0 ? "-" : ""}Rp ${angka}`
+}
