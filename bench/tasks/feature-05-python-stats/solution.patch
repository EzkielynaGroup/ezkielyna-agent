+import unittest
+
+from stats import median, mode
+
+
+class MedianModeTest(unittest.TestCase):
+    def test_median(self):
+        self.assertEqual(median([1, 3, 2]), 2)
+
+    def test_mode(self):
+        self.assertEqual(mode([2, 2, 1]), 2)
