{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    // bench/ is not a workspace package; borrow Bun's types from the CLI package.
    "typeRoots": ["../packages/opencode/node_modules/@types"],
    "types": ["bun"]
  },
  "include": ["*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
